{
  "name": "tf-pipas-backend",
  "version": "1.1.0",
  "description": "Servidor local do TF Pipas System: guarda os dados no SQLite e serve a interface. Roda sem internet.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "TFPIPAS_DEV=1 bun --watch src/principal.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:windows": "bun run scripts/build.ts windows",
    "build:linux": "bun run scripts/build.ts linux"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
